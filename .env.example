SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace_with_smtp_email
SMTP_PASS=replace_with_app_password
MAIL_FROM="Music Club NITW <replace_with_smtp_email>"
ADMIN_EMAIL=replace_with_admin_email

OTP_SECRET=replace_with_a_random_secret_string
ALLOWED_ORIGIN=https://your-domain.vercel.app

SUPABASE_URL=replace_with_supabase_url
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Google Meet link generation (see supabase-setup.md → "Auto-generate Meet links")
GOOGLE_CLIENT_ID=replace_with_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_oauth_client_secret
GOOGLE_REFRESH_TOKEN=replace_with_club_gmail_refresh_token
